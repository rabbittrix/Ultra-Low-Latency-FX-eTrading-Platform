FROM rust:1.82-slim as builder

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services/market-data-service ./services/market-data-service

# Build the service
RUN cargo build --release --bin market-data-service

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/market-data-service /app/market-data-service

EXPOSE 8081 9091

CMD ["./market-data-service"]


FROM rust:1.83-slim as builder

# Install protoc and OpenSSL for proto compilation and TLS
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services ./services
# Copy proto files for fx-proto build
COPY crates/fx-proto/proto ./crates/fx-proto/proto

# Build the service
RUN cargo build --release --bin market-data-service

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/market-data-service /app/market-data-service

EXPOSE 8081 9091

CMD ["./market-data-service"]


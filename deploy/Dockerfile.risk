FROM rust:1.83-slim AS builder

# Install protoc and OpenSSL for proto compilation and TLS
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY services ./services
# Copy proto files for fx-proto build (if needed)
COPY crates/fx-proto/proto ./crates/fx-proto/proto

RUN cargo build --release --bin risk-service

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/risk-service /app/risk-service

EXPOSE 8084 9094

CMD ["./risk-service"]


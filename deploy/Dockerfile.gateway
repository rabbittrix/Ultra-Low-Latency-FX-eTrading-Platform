FROM rust:1.83-slim AS builder

# Install protoc, OpenSSL, and curl for proto compilation, TLS, and Swagger UI download
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libssl-dev \
    pkg-config \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY services ./services
# Copy proto files for fx-proto build (if needed)
COPY crates/fx-proto/proto ./crates/fx-proto/proto

RUN cargo build --release --bin gateway-service

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/gateway-service /app/gateway-service

EXPOSE 8080 9090

CMD ["./gateway-service"]


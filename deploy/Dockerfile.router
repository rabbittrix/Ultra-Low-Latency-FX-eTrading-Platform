FROM rust:1.82-slim as builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY services/router-service ./services/router-service

RUN cargo build --release --bin router-service

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/router-service /app/router-service

EXPOSE 8085 9095

CMD ["./router-service"]


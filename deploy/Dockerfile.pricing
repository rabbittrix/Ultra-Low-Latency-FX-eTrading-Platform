FROM rust:1.91-slim-bookworm AS builder

# Install protoc, OpenSSL, and pkg-config for proto compilation and TLS
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libssl-dev \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY services ./services
# Copy proto files for fx-proto build
COPY crates/fx-proto/proto ./crates/fx-proto/proto

RUN cargo build --release --bin pricing-service

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/pricing-service /app/pricing-service

EXPOSE 8082 9092

CMD ["./pricing-service"]


{
  "dashboard": {
    "title": "Risk Service - Monitoring",
    "tags": ["fx-trading", "risk"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Risk Check Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(risk_checks_total[5m])",
            "legendFormat": "Checks/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Risk Check Success Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "rate(risk_checks_passed_total[5m]) / rate(risk_checks_total[5m]) * 100",
            "legendFormat": "Pass Rate %",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Total Exposure",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "risk_total_exposure",
            "legendFormat": "Exposure",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Position Limit Utilization",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "risk_position_limit_utilization",
            "legendFormat": "Utilization %",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Risk Check Latency",
        "type": "graph",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(risk_check_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(risk_check_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(risk_check_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ]
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    }
  }
}

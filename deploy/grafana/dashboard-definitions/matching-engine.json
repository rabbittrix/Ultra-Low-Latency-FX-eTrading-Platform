{
  "overwrite": true,
  "dashboard": {
    "uid": "fx-matching",
    "title": "Matching Engine - Performance",
    "tags": [
      "fx-trading",
      "matching-engine"
    ],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "Order Matching Latency",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(matching_engine_order_matching_duration_seconds_bucket[5m]))",
            "legendFormat": "p50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(matching_engine_order_matching_duration_seconds_bucket[5m]))",
            "legendFormat": "p95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(matching_engine_order_matching_duration_seconds_bucket[5m]))",
            "legendFormat": "p99",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Latency"
          },
          {
            "format": "short"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 2,
        "title": "Orders Submitted",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(matching_engine_orders_submitted_total[5m])",
            "legendFormat": "Orders/sec",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 3,
        "title": "Trades Executed",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(matching_engine_trades_executed_total[5m])",
            "legendFormat": "Trades/sec",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 4,
        "title": "Order Book Depth",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "matching_engine_orderbook_depth",
            "legendFormat": "Depth",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "id": 5,
        "title": "Active Orders",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "matching_engine_active_orders",
            "legendFormat": "Active",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "editable": true
  }
}
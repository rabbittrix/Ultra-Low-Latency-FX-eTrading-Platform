{
  "name": "ultra-low-latency-fx-etrading",
  "version": "0.1.3",
  "private": true,
  "description": "Root npm proxies for the Tauri trading UI (scripts live under frontend/tauri-trading-ui).",
  "scripts": {
    "dev": "npm --prefix frontend/tauri-trading-ui run dev",
    "dev:stack": "npm --prefix frontend/tauri-trading-ui run dev:stack",
    "build": "npm --prefix frontend/tauri-trading-ui run build",
    "lint": "npm --prefix frontend/tauri-trading-ui run lint",
    "tauri:dev": "npm --prefix frontend/tauri-trading-ui run tauri:dev",
    "tauri:build": "npm --prefix frontend/tauri-trading-ui run tauri:build",
    "install:ui": "npm --prefix frontend/tauri-trading-ui install"
  }
}
